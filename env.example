# AUSSIM — required environment variables
# Copy this file to .env and fill in real values (never commit .env)

# Clerk publishable key — get it from https://dashboard.clerk.com
# For local dev: create an application in Clerk and copy the publishable key.
# For GitHub Pages: add this as a repository secret named VITE_CLERK_PUBLISHABLE_KEY
#   Settings → Secrets and variables → Actions → New repository secret
#
# In the Clerk dashboard you also need to:
#   1. Enable "Email + Password" under User & Authentication → Email, Phone, Username
#   2. Enable "Google" under Social Connections (for Gmail sign-in)
#   3. Add your GitHub Pages URL to Allowed Origins:
#      https://lokanath1209.github.io

VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
